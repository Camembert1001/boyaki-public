{
  "schema": "boyaki-contribution-status-policy-v1",
  "phase": "early-access",
  "principles": {
    "counter_is_projection_not_source_of_truth": true,
    "verified_only_on_profile": true,
    "default_dedupe_rule": "1 case x actor x status type = max 1",
    "candidate_buffer": true,
    "retroactive_promotion": true,
    "light_metrics_are_not_rank_equivalent_to_heavy_metrics": true,
    "commercial_metrics_are_not_contribution_status": true
  },
  "public_profile": {
    "voice": [
      {"id":"voice-useful-input","label":"Useful Inputs","tier":"light","meaning":"Caseを前進させる有効情報を提供したCase数","dedupe_by":"case_id","required_verified_fields":["actor_id","case_id","evidence_id"]},
      {"id":"voice-verified-validation","label":"Verified Validations","tier":"mid","meaning":"他者のSolutionを実環境で検証し、Caseを前進させたCase数","dedupe_by":"case_id","required_verified_fields":["actor_id","case_id","solution_id","evidence_id","independence_verified"]},
      {"id":"voice-resolved-case","label":"Resolved Cases","tier":"heavy","meaning":"Voiceとして有意に関与したCaseが解決まで到達した数","dedupe_by":"case_id","required_verified_fields":["actor_id","case_id","resolution_evidence_id"]}
    ],
    "maker": [
      {"id":"maker-applied-contribution","label":"Applied Contributions","tier":"light","meaning":"具体的な提案・修正がSolutionに採用されたCase数","dedupe_by":"case_id","required_verified_fields":["actor_id","case_id","solution_id","evidence_id"]},
      {"id":"maker-resolved-case","label":"Resolved Cases","tier":"mid","meaning":"自分のMaker contributionが実問題の解決につながったCase数","dedupe_by":"case_id","required_verified_fields":["actor_id","case_id","solution_id","resolution_evidence_id","independence_verified"]},
      {"id":"maker-proven-reuse","label":"Proven Reuse","tier":"heavy","meaning":"同じcanonical Solutionが独立した複数Caseで解決を生んだSolution数","dedupe_by":"solution_id","required_verified_fields":["actor_id","solution_id","independent_resolved_case_count"],"minimum_independent_resolved_case_count":2}
    ]
  },
  "verification_states": ["candidate", "pending", "verified", "revoked"],
  "profile_counted_state": "verified",
  "commercial": {
    "public_profile_exposure": "none",
    "owner_and_operator_only": true,
    "metrics": ["net_revenue", "unique_paying_customers"]
  }
}
